      <aspNetCore processPath="dotnet" arguments=".\ServiceBoost.API.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
